{
  "name": "atendeia-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @atendeia/api && npm run build --workspace @atendeia/web",
    "dev:web": "npm run dev --workspace @atendeia/web",
    "dev:api": "npm run dev --workspace @atendeia/api",
    "test": "npm run test --workspace @atendeia/api && npm run test --workspace @atendeia/web",
    "test:postgresql": "npm run test:postgresql --workspace @atendeia/api",
    "lint": "npm run lint --workspace @atendeia/api && npm run lint --workspace @atendeia/web",
    "db:generate": "npm run db:generate --workspace @atendeia/api",
    "db:migrate": "npm run db:migrate --workspace @atendeia/api",
    "db:deploy": "npm run db:deploy --workspace @atendeia/api",
    "platform-owner:promote": "npm run platform-owner:promote --workspace @atendeia/api --",
    "homologation:verify-email": "npm run homologation:verify-email --workspace @atendeia/api --"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3"
  }
}
